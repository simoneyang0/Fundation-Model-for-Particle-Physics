#!/usr/bin/env python3
"""
Modulo per aggiungere parametri di controllo che confrontano le proprietà dei jet
con la somma delle proprietà dei loro costituenti.
I parametri di controllo sono definiti come: (jet_value - sum_constituents) / mean_jet_value
Per la carica: (jet_charge - sum_constituent_charge) (nessuna normalizzazione)
"""

import dask.dataframe as dd
import numpy as np
import pandas as pd
import dask.array as da


def compute_invariant_mass(pt, eta, phi, mass):
    """
    Calcola la massa invariante da 4-vettori.
    M^2 = (E)^2 - (px)^2 - (py)^2 - (pz)^2
    dove E = sqrt(pt^2 + pz^2 + mass^2) e pz = pt * sinh(eta)
    """
    px = pt * np.cos(phi)
    py = pt * np.sin(phi)
    pz = pt * np.sinh(eta)
    e = np.sqrt(pt**2 + pz**2 + mass**2)
    
    mass_sq = e**2 - px**2 - py**2 - pz**2
    
    if mass_sq < 0:
        mass_sq = 0
    
    return np.sqrt(mass_sq)


def add_jet_control_parameters(ddf):
    """
    Aggiunge parametri di controllo al Dask DataFrame originale.
    Restituisce un nuovo DDF con tutte le colonne originali più:
    - charge_control: differenza tra carica del jet e somma cariche dei costituenti
    - pt_control: (PT_jet - PT_constituents) / mean_PT_jet
    - mass_control: (M_jet - M_constituents) / mean_M_jet
    """
    
    def add_controls_to_partition(partition):
        """Processa una partizione e aggiunge colonne di controllo"""
        
        # Prima passata: calcola medie per normalizzazione
        jet_pt_list = []
        jet_mass_list = []
        
        for _, row in partition.iterrows():
            jet_pt = row.get('FullReco_JetAK4_PT')
            jet_eta = row.get('FullReco_JetAK4_Eta')
            jet_phi = row.get('FullReco_JetAK4_Phi')
            jet_mass = row.get('FullReco_JetAK4_Mass')
            
            if jet_pt is not None and jet_eta is not None and jet_phi is not None and jet_mass is not None:
                for j in range(len(jet_pt)):
                    inv_mass = compute_invariant_mass(
                        jet_pt[j], jet_eta[j], jet_phi[j], jet_mass[j]
                    )
                    jet_mass_list.append(inv_mass)
                    jet_pt_list.append(jet_pt[j])
        
        mean_jet_pt = np.mean(jet_pt_list) if jet_pt_list else 1.0
        #mean_jet_mass = np.mean(jet_mass_list) if jet_mass_list else 1.0
        mean_jet_mass = 91
        
        # Inizializza liste per le nuove colonne
        charge_control_lists = []
        pt_control_lists = []
        mass_control_lists = []
        
        for _, row in partition.iterrows():
            jet_charge = row.get('FullReco_JetAK4_Charge')
            jet_pt = row.get('FullReco_JetAK4_PT')
            jet_eta = row.get('FullReco_JetAK4_Eta')
            jet_phi = row.get('FullReco_JetAK4_Phi')
            jet_mass = row.get('FullReco_JetAK4_Mass')
            jet_constituents = row.get('FullReco_JetAK4_Constituents')
            
            pfcand_charge = row.get('FullReco_PFCand_Charge')
            pfcand_pt = row.get('FullReco_PFCand_PT')
            pfcand_eta = row.get('FullReco_PFCand_Eta')
            pfcand_phi = row.get('FullReco_PFCand_Phi')
            pfcand_mass = row.get('FullReco_PFCand_Mass')
            pfcand_id = row.get('FullReco_PFCand_fUniqueID')
            
            # Inizializza liste per questo evento
            charge_controls = []
            pt_controls = []
            mass_controls = []
            
            if (jet_charge is not None and jet_pt is not None and jet_constituents is not None and
                pfcand_charge is not None and pfcand_pt is not None and pfcand_id is not None):
                
                for jet_idx in range(len(jet_pt)):
                    if jet_idx >= len(jet_constituents):
                        charge_controls.append(np.nan)
                        pt_controls.append(np.nan)
                        mass_controls.append(np.nan)
                        continue
                    
                    constituents_idx = jet_constituents[jet_idx]
                    if constituents_idx is None or len(constituents_idx) == 0:
                        charge_controls.append(np.nan)
                        pt_controls.append(np.nan)
                        mass_controls.append(np.nan)
                        continue
                    
                    # Calcola somma cariche dei costituenti
                    sum_charge = 0.0
                    sum_pt = 0.0
                    
                    # Per massa invariante
                    total_px = 0.0
                    total_py = 0.0
                    total_pz = 0.0
                    total_e = 0.0
                    
                    for idx in constituents_idx:
                        if idx < len(pfcand_charge):
                            # Carica
                            charge_val = pfcand_charge[idx]
                            if isinstance(charge_val, (list, np.ndarray)):
                                charge_val = charge_val[0] if len(charge_val) > 0 else 0
                            sum_charge += charge_val
                            
                            # PT
                            sum_pt += pfcand_pt[idx]
                            
                            # Per massa invariante
                            pt = pfcand_pt[idx]
                            eta = pfcand_eta[idx]
                            phi = pfcand_phi[idx]
                            mass = pfcand_mass[idx]
                            
                            px = pt * np.cos(phi)
                            py = pt * np.sin(phi)
                            pz = pt * np.sinh(eta)
                            e = np.sqrt(pt**2 + pz**2 + mass**2)
                            
                            total_px += px
                            total_py += py
                            total_pz += pz
                            total_e += e
                    
                    # Massa invariante dei costituenti
                    inv_mass_sq = total_e**2 - total_px**2 - total_py**2 - total_pz**2
                    if inv_mass_sq < 0:
                        inv_mass_sq = 0
                    sum_inv_mass = np.sqrt(inv_mass_sq)
                    
                    # Massa invariante del jet
                    jet_inv_mass = compute_invariant_mass(
                        jet_pt[jet_idx], jet_eta[jet_idx], 
                        jet_phi[jet_idx], jet_mass[jet_idx]
                    )
                    
                    # Parametri di controllo
                    charge_val = jet_charge[jet_idx]
                    if isinstance(charge_val, (list, np.ndarray)):
                        charge_val = charge_val[0] if len(charge_val) > 0 else 0
                    
                    charge_control = charge_val - sum_charge
                    pt_control = (jet_pt[jet_idx] - sum_pt) / mean_jet_pt if mean_jet_pt > 0 else np.nan
                    mass_control = (jet_inv_mass - sum_inv_mass) / mean_jet_mass if mean_jet_mass > 0 else np.nan
                    
                    charge_controls.append(charge_control)
                    pt_controls.append(pt_control)
                    mass_controls.append(mass_control)
            else:
                # Dati mancanti
                n_jets = len(jet_pt) if jet_pt is not None else 0
                charge_controls = [np.nan] * n_jets
                pt_controls = [np.nan] * n_jets
                mass_controls = [np.nan] * n_jets
            
            charge_control_lists.append(charge_controls)
            pt_control_lists.append(pt_controls)
            mass_control_lists.append(mass_controls)
        
        # Aggiungi le nuove colonne alla partizione
        partition = partition.copy()
        partition['charge_control'] = charge_control_lists
        partition['pt_control'] = pt_control_lists
        partition['mass_control'] = mass_control_lists
        
        return partition
    
    # Applica la funzione a ogni partizione
    result = ddf.map_partitions(add_controls_to_partition)
    
    return result


def flatten_control_parameters(ddf_with_controls):
    """
    Appiattisce i parametri di controllo (da lista per evento a riga per jet).
    Utile per fare istogrammi.
    """
    
    def flatten_partition(partition):
        rows = []
        for _, row in partition.iterrows():
            charge_controls = row.get('charge_control', [])
            pt_controls = row.get('pt_control', [])
            mass_controls = row.get('mass_control', [])
            
            for i in range(len(charge_controls)):
                rows.append({
                    'charge_control': charge_controls[i] if i < len(charge_controls) else np.nan,
                    'pt_control': pt_controls[i] if i < len(pt_controls) else np.nan,
                    'mass_control': mass_controls[i] if i < len(mass_controls) else np.nan
                })
        return pd.DataFrame(rows)
    
    result = ddf_with_controls.map_partitions(flatten_partition, meta={
        'charge_control': 'float64',
        'pt_control': 'float64',
        'mass_control': 'float64'
    })
    
    return result


def get_charge_differences(ddf):
    """
    Funzione specifica per calcolare solo le differenze di carica.
    Restituisce un Dask DataFrame appiattito con solo charge_control.
    """
    
    def compute_charge_differences_partition(partition):
        rows = []
        
        for _, row in partition.iterrows():
            jet_charge = row.get('FullReco_JetAK4_Charge')
            jet_constituents = row.get('FullReco_JetAK4_Constituents')
            pfcand_charge = row.get('FullReco_PFCand_Charge')
            pfcand_id = row.get('FullReco_PFCand_fUniqueID')
            
            if jet_charge is None or jet_constituents is None or pfcand_charge is None:
                continue
            
            for jet_idx in range(len(jet_charge)):
                if jet_idx >= len(jet_constituents):
                    continue
                
                constituents_idx = jet_constituents[jet_idx]
                if constituents_idx is None or len(constituents_idx) == 0:
                    continue
                
                # Calcola somma cariche
                sum_charge = 0.0
                for idx in constituents_idx:
                    if idx < len(pfcand_charge):
                        charge_val = pfcand_charge[idx]
                        if isinstance(charge_val, (list, np.ndarray)):
                            charge_val = charge_val[0] if len(charge_val) > 0 else 0
                        sum_charge += charge_val
                
                # Carica del jet
                jet_charge_val = jet_charge[jet_idx]
                if isinstance(jet_charge_val, (list, np.ndarray)):
                    jet_charge_val = jet_charge_val[0] if len(jet_charge_val) > 0 else 0
                
                diff = jet_charge_val - sum_charge
                
                rows.append({'charge_control': diff})
        
        return pd.DataFrame(rows)
    
    result = ddf.map_partitions(compute_charge_differences_partition, meta={
        'charge_control': 'float64'
    })
    
    return result


# Esempio di utilizzo
if __name__ == "__main__":
    import matplotlib.pyplot as plt
    
    # Carica i dati
    file_path = "data/tuo_file.parquet"
    
    ddf = dd.read_parquet(file_path, columns=[
        "FullReco_JetAK4_PT",
        "FullReco_JetAK4_Eta",
        "FullReco_JetAK4_Phi",
        "FullReco_JetAK4_Mass",
        "FullReco_JetAK4_Charge",
        "FullReco_JetAK4_Constituents",
        "FullReco_PFCand_PT",
        "FullReco_PFCand_Eta",
        "FullReco_PFCand_Phi",
        "FullReco_PFCand_Mass",
        "FullReco_PFCand_Charge",
        "FullReco_PFCand_fUniqueID"
    ])
    
    print("Dataset caricato")
    print(f"Numero partizioni: {ddf.npartitions}")
    
    # Metodo 1: Ottieni solo le differenze di carica
    print("\n=== Calcolo differenze di carica ===")
    ddf_charge_diff = get_charge_differences(ddf)
    
    # Calcola e plotta
    print("Calcolo in corso...")
    charge_diffs = ddf_charge_diff['charge_control'].compute()
    charge_diffs = charge_diffs.dropna()
    
    print(f"\nDifferenze di carica trovate: {len(charge_diffs)}")
    print(f"Media: {charge_diffs.mean():.6f}")
    print(f"Std: {charge_diffs.std():.6f}")
    print(f"Min: {charge_diffs.min():.6f}")
    print(f"Max: {charge_diffs.max():.6f}")
    
    # Istogramma
    plt.figure(figsize=(10, 6))
    plt.hist(charge_diffs, bins=50, edgecolor='black', alpha=0.7)
    plt.xlabel('Q_jet - Q_constituents')
    plt.ylabel('Count')
    plt.title('Distribuzione delle Differenze di Carica')
    plt.axvline(0, color='red', linestyle='--', alpha=0.5)
    plt.grid(True, alpha=0.3)
    plt.show()
    
    # Metodo 2: Aggiungi tutti i parametri di controllo al DDF originale
    print("\n=== Aggiunta parametri di controllo al DDF ===")
    ddf_with_controls = add_jet_control_parameters(ddf)
    
    print(f"Colonne dopo aggiunta: {ddf_with_controls.columns.tolist()}")
    
    # Appiattisci per istogrammi
    ddf_flat = flatten_control_parameters(ddf_with_controls)
    
    # Calcola statistiche
    print("\nCalcolo statistiche...")
    data = ddf_flat.compute()
    
    print(f"\nSTATISTICHE:")
    print(f"  Charge control: mean={data['charge_control'].mean():.6f}, std={data['charge_control'].std():.6f}")
    print(f"  PT control: mean={data['pt_control'].mean():.6f}, std={data['pt_control'].std():.6f}")
    print(f"  Mass control: mean={data['mass_control'].mean():.6f}, std={data['mass_control'].std():.6f}")