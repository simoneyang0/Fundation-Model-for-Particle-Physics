     ]
    }
   ],
   "source": [
    "diffs = []\n",
    "\n",
    "for ev in range(5):\n",
    "    \n",
    "    jet_charge = ddf['FullReco_JetAK4_Charge'].loc[ev].compute()\n",
    "    jet_constituents = ddf['FullReco_JetAK4_Constituents'].loc[ev].compute()\n",
    "    cons_charge = ddf['FullReco_PFCand_Charge'].loc[ev].compute()\n",
    "    cons_id = ddf['FullReco_PFCand_fUniqueID'].loc[ev].compute()\n",
    "    \n",
    "    for j in range(len(jet_constituents[ev])):\n",
    "        charge = 0\n",
    "        for i in jet_constituents[ev][j]:\n",
    "            idx = np.where(cons_id[ev] == i)[0]\n",
    "            charge += cons_charge[ev][idx]\n",
    "            \n",
    "        diffs.append(jet_charge[ev][j] - charge)\n",
    "\n",
    "diffs = np.hstack(diffs)\n",
    "print(diffs)\n"
   ]
  },
