   "source": [
    "diffs = []\n",
    "\n",
    "for ev in range(100):\n",
    "    \n",
    "    # Usa .iloc[0] per estrarre l'array dalla Series\n",
    "    jet_charge = ddf['FullReco_JetAK4_Charge'].loc[ev].compute().iloc[0]\n",
    "    jet_constituents = ddf['FullReco_JetAK4_Constituents'].loc[ev].compute().iloc[0]\n",
    "    cons_charge = ddf['FullReco_PFCand_Charge'].loc[ev].compute().iloc[0]\n",
    "    cons_id = ddf['FullReco_PFCand_fUniqueID'].loc[ev].compute().iloc[0]\n",
    "    \n",
    "    # Ora jet_charge, jet_constituents, ecc. sono gli array diretti\n",
    "    # Non serve più [ev] perché sono già gli array per quell'evento\n",
    "    for j in range(len(jet_constituents)):\n",
    "        charge = 0\n",
    "        for i in jet_constituents[j]:\n",
    "            idx = np.where(cons_id == i)[0]\n",
    "            if len(idx) > 0:  # Controllo per sicurezza\n",
    "                charge += cons_charge[idx[0]]\n",
    "        \n",
    "        diffs.append(jet_charge[j] - charge)\n",
    "\n",
    "# Converti in array numpy\n",
    "diffs = np.array(diffs)\n",
    "print(diffs)"
   ]
  },
