   "source": [
    "print(\"numero di eventi =\", len(ddf[\"FullReco_JetAK4_PT\"]))\n",
    "\n",
    "n=5\n",
    "\n",
    "# per accedere ai primi n eventi\n",
    "pt_first = ddf['FullReco_JetAK4_PT'].head(n)\n",
