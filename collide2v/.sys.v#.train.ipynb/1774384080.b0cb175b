     "text": [
      "\n",
      "============================================================\n",
      "NORMALIZZAZIONE DATI\n",
      "============================================================\n",
      "Forma dati: (13252, 5)\n",
      "Features: mass, jet_pt, jet_eta, jet_cos_phi, jet_sin_phi\n",
